{
  "schema_version": "1.0",
  "ruleset_id": "hospital-price-table",
  "title": "병의원 시술 가격표 정제 규칙",
  "created": "2026-11-15",
  "source_diagnosis": "진단/병의원수가표_진단.md",
  "approval": {
    "status": "approved",
    "approved_by": "사용자",
    "approved_on": "2026-11-15",
    "note": "초안 A1~A5, B1~B9, C1 승인. 질문 1~4는 사용자 결정 반영"
  },

  "dataset": {
    "file": "data/병의원수가표.xlsx",
    "sheet_index": 0,
    "sheet_name": "시술가격표",
    "header_row": 1,
    "first_data_row": 2,
    "columns": [
      { "name": "시술코드", "type": "text", "role": "key" },
      { "name": "진료과목", "type": "text" },
      { "name": "시술분류", "type": "text" },
      { "name": "시술명", "type": "text", "role": "product" },
      { "name": "시술부위", "type": "text", "role": "product" },
      { "name": "시술횟수", "type": "text", "role": "product", "format": "{n}회" },
      { "name": "정상가격", "type": "number", "role": "product" },
      { "name": "이벤트가격", "type": "number", "role": "product" },
      { "name": "이벤트시작일", "type": "date_text", "format": "YYYY-MM-DD" },
      { "name": "이벤트종료일", "type": "date_text", "format": "YYYY-MM-DD" }
    ],
    "column_lookup": "by_name",
    "missing_required_column": "reject_file"
  },

  "principles": [
    "명확한 형식 오류만 자동 수정한다.",
    "정답을 알 수 없는 값은 임의로 채우거나 변경하지 않는다.",
    "검토 대상은 원래 값을 유지하고 사유를 표시한다.",
    "완전히 동일한 중복 행만 자동 제거한다.",
    "동일한 시술코드에 상품 정보가 충돌하면 두 행 모두 유지한다.",
    "시술명이 비슷하더라도 시술코드가 다르면 자동 병합하지 않는다.",
    "자동 수정 후 가격 관계와 이벤트 기간의 모순을 다시 검사한다.",
    "하나의 행에 여러 오류가 있으면 모든 검토 사유를 기록한다.",
    "정제 규칙에는 각각 적용 컬럼, 처리 방식, 이유(why), 예상 영향을 포함한다.",
    "진단 보고서에서 발견하지 않은 오류를 근거 없이 새로 추가하지 않는다."
  ],

  "actions": {
    "auto_fix": "자동 수정: 결과가 확실한 형식 오류를 고치고 변경 기록에 남긴다.",
    "review": "검토 표시: 값은 그대로 두고 검토 사유를 붙인다.",
    "keep": "그대로 유지: 오류로 확정할 수 없으므로 아무것도 하지 않는다."
  },

  "standards": {
    "시술분류": ["필러", "스킨부스터", "지방흡입", "보톡스", "리프팅", "레이저 시술", "피부관리", "눈성형", "기타 미용 시술"],
    "시술횟수_format": "{n}회",
    "date_format": "YYYY-MM-DD",
    "price_type": "integer"
  },

  "row_identity": {
    "fields": {
      "원본_엑셀행번호": "머리글을 포함한 실제 엑셀 행 번호. 머리글이 1행, 첫 데이터가 2행",
      "데이터순번": "머리글을 제외하고 1부터 센 번호. 원본_엑셀행번호 - 1"
    },
    "assign_at": "load",
    "rules": [
      "파일을 읽자마자 모든 데이터 행에 원본_엑셀행번호와 데이터순번을 붙인다.",
      "이 번호는 행 삭제나 값 수정 뒤에도 바뀌지 않는다. 남은 행의 번호를 다시 매기지 않는다.",
      "정리본에도 원본_엑셀행번호 컬럼을 넣는다.",
      "변경 기록과 검토 목록에는 두 번호를 모두 적는다."
    ]
  },

  "change_log": {
    "fields": ["원본_엑셀행번호", "데이터순번", "시술코드", "변경컬럼", "변경전값", "변경후값", "처리방식", "처리이유", "규칙ID"],
    "row_number_basis": "원본_엑셀행번호는 머리글을 포함한 실제 엑셀 행 번호이고, 데이터순번은 머리글을 제외한 순번이다.",
    "entries": {
      "auto_fix": "값을 바꾼 칸마다 한 줄씩 기록한다. 바꾸기 전과 바꾼 뒤의 값이 같으면 기록하지 않는다.",
      "row_removed": "삭제한 행마다 한 줄씩 기록한다. 변경컬럼은 '(행 전체)', 변경전값은 10개 컬럼 값 전체, 변경후값은 '(삭제)'. 처리이유에 남긴 행의 원본_엑셀행번호를 적는다.",
      "review": "검토 사유마다 한 줄씩 기록한다. 변경후값은 '(변경 없음)'. 한 행에 사유가 여러 개면 여러 줄로 남긴다."
    },
    "value_display": "변경전값은 원본에 저장된 그대로 적는다. 텍스트 금액은 따옴표째, 엑셀 날짜값은 날짜로 적는다."
  },

  "format_fallback": {
    "policy": "review",
    "applies_to": ["FMT-01", "FMT-03", "FMT-04", "FMT-05", "FMT-06"],
    "description": "형식을 통일하는 컬럼(정상가격, 이벤트가격, 이벤트시작일, 이벤트종료일, 시술횟수)에 어떤 형식에도 맞지 않는 값이 있으면 고치지 않고 '알 수 없는 형식'으로 검토 표시한다.",
    "why": "정답을 알 수 없는 값은 임의로 변경하지 않는다는 원칙에 따른 안전장치. 새 오류 유형을 만드는 규칙이 아니다.",
    "expected_impact": { "count": 0, "note": "현재 파일에서는 해당 없음" }
  },

  "execution_order": [
    { "step": 1, "phase": "load", "description": "파일 읽기, 컬럼 이름 확인, 원본 행 번호 부여", "rules": [] },
    { "step": 2, "phase": "deduplicate", "description": "원본 값 그대로 완전 중복 행 제거", "rules": ["DUP-01"] },
    { "step": 3, "phase": "normalize", "description": "형식 자동 수정", "rules": ["FMT-01", "FMT-02", "FMT-03", "FMT-04", "FMT-05", "FMT-06", "FMT-07"] },
    { "step": 4, "phase": "validate_values", "description": "값 단위 검토", "rules": ["REV-01", "REV-02", "REV-03", "REV-04", "REV-08", "REV-09"] },
    { "step": 5, "phase": "validate_relations", "description": "자동 수정을 마친 값으로 가격 관계와 이벤트 기간 재검사", "rules": ["REV-05", "REV-06", "REV-07"] },
    { "step": 6, "phase": "validate_codes", "description": "같은 시술코드끼리 비교", "rules": ["REV-10", "REV-11"] },
    { "step": 7, "phase": "keep", "description": "병합 금지 확인", "rules": ["KEEP-01"] },
    { "step": 8, "phase": "output", "description": "정리본, 변경 기록, 검토 목록 생성", "rules": [] }
  ],

  "rules": [
    {
      "id": "DUP-01",
      "name": "완전 중복 행 제거",
      "action": "auto_fix",
      "operation": "remove_row",
      "columns": ["시술코드", "진료과목", "시술분류", "시술명", "시술부위", "시술횟수", "정상가격", "이벤트가격", "이벤트시작일", "이벤트종료일"],
      "condition": {
        "type": "exact_duplicate_row",
        "compare": "raw_values",
        "compare_note": "자동 수정 전의 원본 값으로 비교한다. 10개 컬럼의 값과 저장 형식(숫자, 텍스트, 날짜, 빈칸)이 모두 같아야 한다.",
        "keep": "first_occurrence",
        "remove": "later_occurrences"
      },
      "why": "모든 값이 같은 행은 지워도 정보가 사라지지 않는다. 먼저 등록된 행을 남기고 나중에 추가된 행을 지운다. 원본 데이터로 다시 확인해 완전히 같은 경우에만 지운다.",
      "log": { "reason_template": "완전 중복 행 삭제 (유지한 행: 원본 엑셀 {kept_row}행)" },
      "diagnosis_ref": "6. 중복",
      "expected_impact": {
        "count": 3,
        "unit": "행 삭제",
        "rows": [
          { "remove": 204, "keep": 39, "code": "FIL-015" },
          { "remove": 203, "keep": 83, "code": "SKB-015" },
          { "remove": 202, "keep": 139, "code": "LIP-004" }
        ],
        "note": "데이터 행 210개가 207개로 줄어든다. 3쌍 모두 원본 값까지 같은 것을 2026-11-15에 다시 확인했다."
      }
    },
    {
      "id": "FMT-01",
      "name": "텍스트 금액을 숫자로 변환",
      "action": "auto_fix",
      "operation": "parse_price",
      "columns": ["정상가격", "이벤트가격"],
      "condition": {
        "type": "text_matches",
        "pattern": "^\\s*-?(\\d{1,3}(,\\d{3})+|\\d+)\\s*원?\\s*$"
      },
      "transform": { "remove": [",", "원", " "], "to": "integer" },
      "on_unmatched_text": "format_fallback",
      "why": "쉼표와 '원'은 표기일 뿐 금액은 바뀌지 않는다. 가격을 숫자로 통일해야 합계와 가격 관계를 검사할 수 있다.",
      "diagnosis_ref": "3. 섞인 형식 - 금액이 텍스트로 저장된 칸",
      "expected_impact": {
        "count": 6,
        "unit": "칸",
        "rows": [
          { "row": 40, "column": "이벤트가격", "from": "264,000", "to": 264000 },
          { "row": 43, "column": "정상가격", "from": "500,000원", "to": 500000 },
          { "row": 110, "column": "정상가격", "from": "30,000", "to": 30000 },
          { "row": 131, "column": "정상가격", "from": "88,000", "to": 88000 },
          { "row": 166, "column": "정상가격", "from": "1,480,000원", "to": 1480000 },
          { "row": 189, "column": "이벤트가격", "from": "34,000원", "to": 34000 }
        ],
        "note": "변환 뒤 6행은 REV-05, REV-06으로 판정할 수 있게 된다. 진단 데이터 기준으로 새 위반은 없다."
      }
    },
    {
      "id": "FMT-02",
      "name": "시술명·시술부위 앞뒤 공백 제거",
      "action": "auto_fix",
      "operation": "trim",
      "columns": ["시술명", "시술부위"],
      "condition": { "type": "has_leading_or_trailing_whitespace" },
      "transform": { "trim": "both", "inner_spaces": "unchanged" },
      "why": "앞뒤 공백은 뜻이 없고, 같은 값을 다르게 보이게 만든다. 단어 사이 띄어쓰기는 뜻이 달라질 수 있어 건드리지 않는다(REV-09에서 검토).",
      "diagnosis_ref": "3. 섞인 형식 - 앞뒤 공백",
      "expected_impact": {
        "count": 2,
        "unit": "칸",
        "rows": [
          { "row": 141, "column": "시술명", "from": "종아리 지방흡입  ", "to": "종아리 지방흡입" },
          { "row": 148, "column": "시술명", "from": " 등 미세 지방흡입", "to": "등 미세 지방흡입" }
        ],
        "note": "시술부위에는 해당 칸이 없다."
      }
    },
    {
      "id": "FMT-03",
      "name": "날짜를 YYYY-MM-DD로 통일",
      "action": "auto_fix",
      "operation": "parse_date",
      "columns": ["이벤트시작일", "이벤트종료일"],
      "condition": {
        "type": "date_matches_any",
        "accepted_inputs": [
          { "kind": "text", "pattern": "^\\s*(\\d{4})-(\\d{1,2})-(\\d{1,2})\\s*$", "example": "2026-06-01" },
          { "kind": "text", "pattern": "^\\s*(\\d{4})\\.(\\d{1,2})\\.(\\d{1,2})\\s*$", "example": "2026.10.14" },
          { "kind": "text", "pattern": "^\\s*(\\d{4})/(\\d{1,2})/(\\d{1,2})\\s*$", "example": "2026/08/05" },
          { "kind": "text", "pattern": "^\\s*(\\d{4})\\s*년\\s*(\\d{1,2})\\s*월\\s*(\\d{1,2})\\s*일\\s*$", "example": "2026년 1월 1일" },
          { "kind": "excel_date", "example": "엑셀 날짜값(날짜 서식 셀)" }
        ],
        "group_order": "year-month-day",
        "require_valid_calendar_date": true
      },
      "transform": { "to": "text", "format": "YYYY-MM-DD" },
      "on_unmatched": "format_fallback",
      "why": "모두 연-월-일 순서라 해석이 하나뿐이다. 날짜 표기를 통일해야 이벤트 기간을 비교할 수 있다. 다수 표기인 YYYY-MM-DD 텍스트에 맞춘다.",
      "diagnosis_ref": "3. 섞인 형식 - 날짜 표기",
      "expected_impact": {
        "count": 6,
        "unit": "칸",
        "rows": [
          { "row": 4, "column": "이벤트시작일", "from": "2026년 1월 1일", "to": "2026-01-01" },
          { "row": 165, "column": "이벤트시작일", "from": "2026/08/05", "to": "2026-08-05" },
          { "row": 10, "column": "이벤트종료일", "from": "2026.10.14", "to": "2026-10-14" },
          { "row": 16, "column": "이벤트종료일", "from": "2027.01.02", "to": "2027-01-02" },
          { "row": 48, "column": "이벤트종료일", "from": "2026년 10월 15일", "to": "2026-10-15" },
          { "row": 153, "column": "이벤트종료일", "from": "엑셀 날짜값 2026-04-02", "to": "2026-04-02" }
        ],
        "note": "빈칸은 이 규칙의 대상이 아니다(REV-03). REV-07 위반 결과는 바뀌지 않는다."
      }
    },
    {
      "id": "FMT-04",
      "name": "시술횟수 '숫자 회' 공백 제거",
      "action": "auto_fix",
      "operation": "normalize_count",
      "columns": ["시술횟수"],
      "condition": { "type": "text_matches", "pattern": "^\\s*(\\d+)\\s*회\\s*$" },
      "transform": { "template": "{1}회" },
      "why": "'1 회'와 '1회'는 띄어쓰기만 다르고 뜻이 같다.",
      "diagnosis_ref": "3. 섞인 형식 - 시술횟수 표기",
      "expected_impact": {
        "count": 1,
        "unit": "칸",
        "rows": [ { "row": 104, "from": "1 회", "to": "1회" } ],
        "note": "이미 '{n}회' 형식인 값은 바뀌지 않으므로 기록하지 않는다."
      }
    },
    {
      "id": "FMT-05",
      "name": "시술횟수 '숫자번'을 '숫자회'로",
      "action": "auto_fix",
      "operation": "normalize_count",
      "columns": ["시술횟수"],
      "condition": { "type": "text_matches", "pattern": "^\\s*(\\d+)\\s*번\\s*$" },
      "transform": { "template": "{1}회" },
      "why": "사용자 결정(질문 1): 횟수 컬럼에서 '5번'은 '5회'와 뜻이 분명히 같다.",
      "diagnosis_ref": "3. 섞인 형식 - 시술횟수 표기",
      "expected_impact": { "count": 1, "unit": "칸", "rows": [ { "row": 72, "from": "5번", "to": "5회" } ] }
    },
    {
      "id": "FMT-06",
      "name": "시술횟수 숫자만 있는 값에 '회' 붙이기",
      "action": "auto_fix",
      "operation": "normalize_count",
      "columns": ["시술횟수"],
      "condition": { "type": "text_or_number_matches", "pattern": "^\\s*(\\d+)\\s*$" },
      "transform": { "template": "{1}회" },
      "why": "사용자 결정(질문 1): 횟수 컬럼에 숫자만 있는 '5'는 '5회'라는 뜻이 분명하다.",
      "diagnosis_ref": "3. 섞인 형식 - 시술횟수 표기",
      "expected_impact": { "count": 1, "unit": "칸", "rows": [ { "row": 191, "from": "5", "to": "5회" } ] }
    },
    {
      "id": "FMT-07",
      "name": "시술분류를 표준 명칭으로 통일",
      "action": "auto_fix",
      "operation": "map_to_standard",
      "columns": ["시술분류"],
      "condition": {
        "type": "matches_standard_ignoring_spaces",
        "standard_list": "standards.시술분류",
        "match": "값과 표준 명칭에서 공백을 모두 뺐을 때 같으면 해당 표준 명칭으로 바꾼다.",
        "approved_mappings": [
          { "from": "스킨 부스터", "to": "스킨부스터" },
          { "from": "눈 성형", "to": "눈성형" },
          { "from": "기타미용시술", "to": "기타 미용 시술" }
        ]
